{
  "name": "paperclip-plugins",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "pnpm -r build",
